{
  "$schema": "https://opencode.ai/config.json",
  "model": "tensorzero/tensorzero::function_name::lunarwing",
  "share": "disabled",
  "update": "disable",
  "plugins": ["/app/scripts/lunarwing_tool_plugin"],
  "permissions": [
    { "action": "shell", "resource": "*opencode service *", "effect": "deny" },
    { "action": "shell", "resource": "*opencode pair *", "effect": "deny" },
    { "action": "shell", "resource": "*opencode serve *", "effect": "deny" }
  ],
  "providers": {
    "tensorzero": {
      "name": "TensorZero",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "apiKey": "unneeded",
        "baseURL": "http://set-opencode2-base-url.invalid/openai/v1/"
      },
      "models": {
        "tensorzero::function_name::lunarwing": {
          "name": "tensorzero::function_name::lunarwing",
          "limit": {
            "context": 959000,
            "output": 131072
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    }
  }
}
