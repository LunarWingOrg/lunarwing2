{
  "name": "lunarwing-tui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LunarWing multimodal terminal client (voice and images) on Bun and OpenTUI",
  "bin": {
    "lunarwing-tui": "./bin/lunarwing-tui"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun run src/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "0.8.1",
    "@opentui/react": "0.8.1",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
