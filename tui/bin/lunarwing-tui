#!/usr/bin/env bun
// LunarWing TUI launcher (design 3.1, 3.2). Bun only: OpenTUI 0.8.1 needs bun >= 1.3.14; Node is not supported.
// src/main.tsx is imported dynamically, after the runtime check, relative to this file's real path, so the
// launcher also works through a symlink (bun link, ~/.local/bin). This file is outside the tsc include list.
const MIN_BUN = "1.3.14"

if (typeof Bun === "undefined" || !Bun.semver.satisfies(Bun.version, `>=${MIN_BUN}`)) {
  process.stderr.write(`lunarwing-tui needs Bun >= ${MIN_BUN} (Node is not supported)\n`)
  process.exit(1)
}

await import(new URL("../src/main.tsx", import.meta.url).href)
