[Unit]
Description=LunarWing Vision OCR Sidecar (rootless Podman)
Documentation=https://git.lunarwing.org/lunarwing/lunarwing2/-/tree/master/projects/ocr-sidecar
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/lunarwing/projects/ocr-sidecar
EnvironmentFile=%h/.config/lunarwing/ocr-sidecar.env
ExecStartPre=-/usr/bin/podman compose down --remove-orphans
ExecStart=/usr/bin/podman compose up --build --remove-orphans
ExecStartPost=/usr/bin/timeout 120 /bin/sh -ec 'until /usr/bin/podman exec lunarwing-ocr-sidecar curl --fail --silent --output /dev/null --max-time 3 http://127.0.0.1:8089/health; do sleep 1; done'
ExecStop=/usr/bin/podman compose down
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60
UMask=0077

# Install as the user who owns the rootless Podman store:
#   ~/.config/systemd/user/ocr-sidecar.service
# Enable with: systemctl --user enable --now ocr-sidecar.service

[Install]
WantedBy=default.target
