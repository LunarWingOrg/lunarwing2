#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# LunarWing Infrastructure Health Check — Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to config.sh and edit as needed:
#   cp config.sh.example config.sh
#
# Then source it from cron-wrapper.sh or set in your environment / systemd unit.
# Every variable below has a sensible default — all are optional.
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
# Global / cross-component
# ═════════════════════════════════════════════════════════════════════════════

# Base directory for LunarWing installs (locks, sessions, state).
# Most checks derive paths from this.
#LUNARWING_BASE_DIR="/opt/lunarwing"

# Legacy alias: IRONCLAW_BASE_DIR is still accepted when LUNARWING_BASE_DIR
# is unset.
#IRONCLAW_BASE_DIR="/var/lib/lunarwing"

# Rate-limit state directory (shared between gateway and health check).
#RATELIMIT_DIR="/var/lib/lunarwing/ratelimit"

# ═════════════════════════════════════════════════════════════════════════════
# Notification
# ═════════════════════════════════════════════════════════════════════════════

# When false, don't page on every per-run degrade — let self-heal escalations
# page instead. Useful to reduce noise during transient blips.
#HEALTHCHECK_NOTIFY=true

# ═════════════════════════════════════════════════════════════════════════════
# Component: gateway (agent sessions)
# ═════════════════════════════════════════════════════════════════════════════

# Uses LUNARWING_BASE_DIR / IRONCLAW_BASE_DIR for the sessions directory.
# Degraded/critical thresholds (defaults shown):
#HEALTH_GATEWAY_STALE_LOCK_MINUTES=10      # lock older than this is "stale"
#HEALTH_GATEWAY_STALE_LOCKS_CRITICAL=3     # more than this many stale locks
#HEALTH_GATEWAY_ORPHAN_DEGRADED=10         # orphan transcripts > N -> degraded
#HEALTH_GATEWAY_ORPHAN_CRITICAL=50         # orphan transcripts > N -> critical
#HEALTH_GATEWAY_OVERSIZED_DEGRADED=0       # oversized (>500KB) sessions > N

# ═════════════════════════════════════════════════════════════════════════════
# Component: xmpp (XMPP bridge reachability + latency)
# ═════════════════════════════════════════════════════════════════════════════

#HEALTH_XMPP_SERVER="xmpp.sobe.world"
#HEALTH_XMPP_PORT=5222

# Thresholds (defaults shown).
#HEALTH_XMPP_LATENCY_DEGRADED_MS=500
#HEALTH_XMPP_LATENCY_CRITICAL_MS=2000
#HEALTH_XMPP_ERROR_DEGRADED=1
#HEALTH_XMPP_ERROR_CRITICAL=5

# ═════════════════════════════════════════════════════════════════════════════
# Component: omemo (OMEMO encryption store)
# ═══════════════════════════════════════════════════════ engine ══════════════

# Set to non-"true" to disable the OMEMO store probe entirely.
#HEALTH_OMEMO_ENABLED=true

# ═════════════════════════════════════════════════════════════════════════════
# Component: ratelimit (rate-limiter state directory)
# ═════════════════════════════════════════════════════════════════════════════

# Uses RATELIMIT_DIR (see Global section). Thresholds (defaults shown):
#HEALTH_RATELIMIT_THROTTLED_DEGRADED=10  # throttled events/hour -> degraded
#HEALTH_RATELIMIT_THROTTLED_CRITICAL=50
#HEALTH_RATELIMIT_QUEUE_DEGRADED=100     # queued messages > N -> degraded

# ═════════════════════════════════════════════════════════════════════════════
# Component: clickhouse (ClickHouse analytics DB)
# ═══════════════════════════════  key engine ═════════════════════════════════

# No tunable connection env vars — uses clickhouse-client when available.
# Thresholds (defaults shown; percent for disk/memory, ms for query time):
#HEALTH_CLICKHOUSE_DISK_DEGRADED=70
#HEALTH_CLICKHOUSE_DISK_CRITICAL=85
#HEALTH_CLICKHOUSE_MEMORY_DEGRADED=80
#HEALTH_CLICKHOUSE_MEMORY_CRITICAL=95
#HEALTH_CLICKHOUSE_QUERY_DEGRADED_MS=1000
#HEALTH_CLICKHOUSE_QUERY_CRITICAL_MS=5000

# ═════════════════════════════════════════════════════════════════════════════
# Component: tensorzero (TensorZero gateway / model router)
# ═════════════════════════════════════════════════════════════════════════════

# Probes ClickHouse (or GPU fallback). Thresholds (defaults shown):
#HEALTH_TENSORZERO_P95_DEGRADED_MS=5000
#HEALTH_TENSORZERO_P95_CRITICAL_MS=15000
#HEALTH_TENSORZERO_ERROR_DEGRADED_PCT=1   # Floats allowed for ERROR_* only
#HEALTH_TENSORZERO_ERROR_CRITICAL_PCT=5
#HEALTH_TENSORZERO_QUEUE_DEGRADED=5
#HEALTH_TENSORZERO_QUEUE_CRITICAL=20
#HEALTH_TENSORZERO_GPU_UTIL_WARN_PCT=90   # Advisory issue only; never critical

# ═════════════════════════════════════════════════════════════════════════════
# Component: models (LLM provider APIs)
# ═════════════════════════════════════════════════════════════════════════════

# Set to non-"true" to disable the LLM-provider probe entirely.
#HEALTH_MODELS_ENABLED=true

# Latency thresholds applied per provider, milliseconds (defaults shown).
#HEALTH_MODELS_LATENCY_DEGRADED_MS=3000
#HEALTH_MODELS_LATENCY_CRITICAL_MS=10000

# ═════════════════════════════════════════════════════════════════════════════
# Component: lunarvision (OCR + VL sidecar) — Added 2026-06-24
# ═════════════════════════════════════════════════════════════════════════════

# Set to non-"true" to disable the LunarVision probe entirely.
#HEALTH_LUNARVISION_ENABLED=true

# Sidecar operational base URL (serves /health and /vision/metrics).
# Single-node override only. On multi-tenant hosts leave this UNSET so the
# check discovers each tenant's vision_health port from the ports registry
# (SELF_HEAL_TENANTS_FILE / /etc/lunarwing/ports.json). Default single-node
# fallback is http://127.0.0.1:8089 when no registry ports exist.
#HEALTH_LUNARVISION_URL="http://127.0.0.1:8089"

# curl timeout in seconds for /health and /vision/metrics probes.
#HEALTH_LUNARVISION_TIMEOUT=5

# Also probe /vision/metrics for request counts, cache stats, and rate
# limiting data. Set to "false" for a lighter check (health endpoint only).
#HEALTH_LUNARVISION_FETCH_METRICS=true

# Degrade if the VL backend is not confirmed available. Useful when your
# deployment requires vision-language capabilities, not just OCR.
#HEALTH_LUNARVISION_REQUIRE_VL=false

# Health-endpoint latency thresholds (milliseconds).
#HEALTH_LUNARVISION_LATENCY_DEGRADED_MS=2000
#HEALTH_LUNARVISION_LATENCY_CRITICAL_MS=5000

# ═════════════════════════════════════════════════════════════════════════════
# Component: lunarvoice (local ONNX STT/TTS/VAD)
# ═════════════════════════════════════════════════════════════════════════════

# `auto` probes enabled registry tenants or an explicit URL and otherwise
# reports healthy/not-configured. Set true to force single-node 8091 fallback;
# set false to disable entirely.
#HEALTH_LUNARVOICE_ENABLED=auto

# Single-node health-listener override. Leave unset on multi-tenant hosts so
# every enabled tenant is discovered from voice_health in the ports registry.
# No enabled tenants reports healthy/disabled. Invalid enablement, missing or
# duplicate ports, unreachable listeners, and unready STT report critical.
#HEALTH_LUNARVOICE_URL="http://127.0.0.1:8091"

# Per-request timeout for /health, /ready, and /metrics.
#HEALTH_LUNARVOICE_TIMEOUT=5
# Metrics are optional; /health and /ready always remain mandatory.
#HEALTH_LUNARVOICE_FETCH_METRICS=true

# ═════════════════════════════════════════════════════════════════════════════
# Component: netbird (host tunnel peer readiness)
# ═════════════════════════════════════════════════════════════════════════════

# Opt in to `netbird status --check startup`. Disabled by default because
# NetBird enrollment and daemon lifecycle are operator-owned.
#HEALTH_NETBIRD_ENABLED=false

# Optional binary/path override and readiness timeout in seconds.
#NETBIRD_BINARY="netbird"
#HEALTH_NETBIRD_TIMEOUT=5

# ═════════════════════════════════════════════════════════════════════════════
# Component: svcmgr (service manager — systemd / openrc / launchd)
# ═════════════════════════════════════════════════════════════════════════════

# The service manager check is auto-detected. One environment variable is
# available for OpenRC specifically:
#HEALTH_OPENRC_STATUS_TIMEOUT=8

# ═════════════════════════════════════════════════════════════════════════════
# Self-healing
# ═════════════════════════════════════════════════════════════════════════════

# Suppress repeat pages for one service after confirmed delivery. Set 0 to
# disable. Missing, failed, or cooldown-deferred delivery remains pending and
# retries on later self-heal ticks.
#SELF_HEAL_ESCALATE_COOLDOWN=3600

# Base LunarWing systemd services live on `system` bus for host-global MT
# installs and on `user` bus for user-timer/single-node installs. Tenant units
# always resolve through owning user's bus; host NetBird daemon stays on system.
#SELF_HEAL_SYSTEMD_SCOPE=system

# Bound (seconds) around each init-system probe/remediation call: per-tenant
# systemd user-bus calls (restart / is-active / show) AND OpenRC rc-service
# status/restart. A wedged tenant user manager or hung supervise-daemon
# otherwise stalls the entire self-heal tick. Requires coreutils timeout(1);
# unbounded when unavailable. SELF_HEAL_SYSTEMD_PROBE_TIMEOUT remains as a
# legacy alias.
#SELF_HEAL_PROBE_TIMEOUT=15
#SELF_HEAL_SYSTEMD_PROBE_TIMEOUT=15

# NetBird failures are monitor-only by default. Enable only when operator
# delegates restart ownership to LunarWing.
#SELF_HEAL_NETBIRD_REMEDIATE=false

# ═════════════════════════════════════════════════════════════════════════════
# Metrics exporter (Prometheus textfile; see docs/proposals/HEALTHPOINT_METRICS_EXPORTER.md)
# ═════════════════════════════════════════════════════════════════════════════

# Master switch for the textfile export step run by cron-wrapper.sh after each
# health check. No listener and no port are opened by the textfile path.
#HEALTH_METRICS_EXPORT_ENABLED=true

# Textfile collector target. Written atomically (tmp + mv, mode 0644 per the
# node_exporter textfile convention; series are non-secret by design) in the
# same directory. Point node_exporter's --collector.textfile.directory here.
#HEALTH_METRICS_OUTPUT="/path/to/reports/health/metrics.prom"

# Also export self-heal state series (restarts/escalated/backoff/flapping).
#HEALTH_METRICS_INCLUDE_SELFHEAL=true

# Early-warning threshold file (see health-metrics-thresholds.conf.example).
#HEALTH_METRICS_THRESHOLDS_FILE=/etc/lunarwing/health-metrics-thresholds.conf

# Send a Gotify warning when an early-warning threshold crosses. Warnings are
# deduplicated per metric+severity using the cooldown below.
#HEALTH_METRICS_EARLY_WARNING_NOTIFY=false

# Early-warning notification cooldown in seconds. Defaults to
# SELF_HEAL_ESCALATE_COOLDOWN when unset.
#HEALTH_METRICS_NOTIFY_COOLDOWN=3600

# Optional loopback-only HTTP listener ("127.0.0.1:<port>") serving the same
# exposition on GET /metrics, for hosts without a textfile collector. Empty
# (default) keeps the listener off. On multi-tenant hosts the port comes from
# the v16 health_metrics slot in the ports registry — never hardcode one.
#HEALTH_METRICS_LISTEN=""

# Bearer token for the optional listener; empty = no auth on loopback.
#HEALTH_METRICS_TOKEN=""
