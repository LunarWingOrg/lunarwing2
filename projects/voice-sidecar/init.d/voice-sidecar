#!/sbin/openrc-run
# Standalone OpenRC service for LunarVoice on bare metal.
# Multi-tenant hosts should use lunarwing-mt-admin.sh instead.

description="LunarVoice ONNX sidecar"

: "${voice_user:=lunarvoice}"
: "${voice_group:=lunarvoice}"
: "${voice_env_file:=/etc/lunarwing/voice-sidecar.env}"
: "${voice_wait:=60}"
: "${output_log:=/var/log/lunarvoice.log}"
: "${error_log:=/var/log/lunarvoice.err}"

supervisor="supervise-daemon"
command="/opt/lunarvoice/lunarwing-voice-sidecar"
command_user="${voice_user}:${voice_group}"
command_environment="LD_LIBRARY_PATH=/opt/lunarvoice/lib"
respawn_delay=5
respawn_max=5
respawn_period=300

depend() {
    need net localmount
    after firewall
}

start_pre() {
    # The env file carries VOICE_AUTH_TOKEN: it is secret data. Require a
    # regular, non-symlinked, owner-only file before reading it as root, and
    # never log its contents.
    [ -f "${voice_env_file}" ] && [ ! -L "${voice_env_file}" ] || {
        eerror "regular environment file required: ${voice_env_file}"
        return 1
    }
    [ "$(stat -c %a "${voice_env_file}" 2>/dev/null)" = "600" ] || {
        eerror "environment file must have mode 0600: ${voice_env_file}"
        return 1
    }
    checkpath -d -m 0750 -o "${voice_user}:${voice_group}" /run/lunarvoice || return 1
    checkpath -f -m 0640 -o "${voice_user}:${voice_group}" "${output_log}" || return 1
    checkpath -f -m 0640 -o "${voice_user}:${voice_group}" "${error_log}" || return 1
    set -a
    . "${voice_env_file}"
    set +a
}

voice_ready() {
    local base="http://127.0.0.1:${VOICE_HEALTH_PORT:-8091}"
    curl --fail --silent --output /dev/null --max-time 3 "${base}/health" 2>/dev/null \
        && curl --fail --silent --output /dev/null --max-time 3 "${base}/ready" 2>/dev/null
}

start_post() {
    local waited=0
    ebegin "Waiting for LunarVoice STT readiness"
    while ! voice_ready; do
        waited=$((waited + 1))
        if [ "${waited}" -ge "${voice_wait}" ]; then
            eend 1 "not ready after ${voice_wait}s"
            return 1
        fi
        sleep 1
    done
    eend 0
}
