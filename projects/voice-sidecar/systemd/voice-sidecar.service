[Unit]
Description=LunarVoice ONNX Sidecar
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=lunarvoice
Group=lunarvoice
Environment=LD_LIBRARY_PATH=/opt/lunarvoice/lib
Environment=VOICE_MODEL_DIR=/var/lib/lunarvoice/models
EnvironmentFile=/etc/lunarwing/voice-sidecar.env
ExecStart=/opt/lunarvoice/lunarwing-voice-sidecar
ExecStartPost=/usr/bin/timeout 60 /bin/sh -ec 'until /usr/bin/curl --fail --silent --output /dev/null --max-time 3 "http://127.0.0.1:${VOICE_HEALTH_PORT:-8091}/health" && /usr/bin/curl --fail --silent --output /dev/null --max-time 3 "http://127.0.0.1:${VOICE_HEALTH_PORT:-8091}/ready"; do sleep 1; done'
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/lunarvoice/models
RestrictSUIDSGID=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
