[Unit]
Description=LunarVoice ONNX Sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lunarvoice
Group=lunarvoice
EnvironmentFile=/etc/lunarwing/voice-sidecar.env
Environment=LD_LIBRARY_PATH=/opt/lunarvoice/lib
ExecStart=/opt/lunarvoice/lunarwing-voice-sidecar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/lunarvoice/models
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
