# Authentication and listeners. Authentication is required by default.
VOICE_AUTH_TOKEN=replace-with-a-long-random-token
VOICE_ALLOW_UNAUTHENTICATED=false
# Keep 127.0.0.1 for bare metal. Containers override this to 0.0.0.0 and
# publish both host ports on loopback only. API and health ports must differ.
VOICE_BIND_HOST=127.0.0.1
VOICE_PORT=8090
VOICE_HEALTH_PORT=8091

# Model root and STT. whisper models use sherpa-onnx-<VOICE_STT_MODEL>/
# <size>-{encoder,decoder}.int8.onnx + <size>-tokens.txt. parakeet models use
# sherpa-onnx-nemo-<VOICE_STT_MODEL>/{encoder,decoder,joiner}.int8.onnx + tokens.txt.
VOICE_MODEL_DIR=/models
VOICE_STT_ENGINE=whisper
VOICE_STT_MODEL=whisper-tiny
VOICE_STT_LANGUAGE=auto
VOICE_REQUIRE_STT=true
# Optional absolute artifact overrides:
#VOICE_STT_ENCODER=/models/sherpa-onnx-whisper-tiny/tiny-encoder.int8.onnx
#VOICE_STT_DECODER=/models/sherpa-onnx-whisper-tiny/tiny-decoder.int8.onnx
#VOICE_STT_JOINER=/models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8/joiner.int8.onnx
#VOICE_STT_TOKENS=/models/sherpa-onnx-whisper-tiny/tiny-tokens.txt

# Voice activity detection.
VOICE_ENABLE_VAD=true
VOICE_VAD_MODEL=/models/silero_vad.onnx

# Kokoro text-to-speech. VOICE_TTS_VOICES_JSON maps public names to speaker IDs.
VOICE_ENABLE_TTS=true
VOICE_TTS_MODEL=/models/kokoro-multi-lang-v1_0/model.onnx
VOICE_TTS_VOICES=/models/kokoro-multi-lang-v1_0/voices.bin
VOICE_TTS_TOKENS=/models/kokoro-multi-lang-v1_0/tokens.txt
VOICE_TTS_DATA_DIR=/models/kokoro-multi-lang-v1_0/espeak-ng-data
VOICE_TTS_DICT_DIR=/models/kokoro-multi-lang-v1_0/dict
VOICE_TTS_LEXICON=/models/kokoro-multi-lang-v1_0/lexicon-us-en.txt,/models/kokoro-multi-lang-v1_0/lexicon-zh.txt
VOICE_TTS_DEFAULT_VOICE=af_heart
VOICE_TTS_VOICES_JSON='{"af_heart":0}'

# Request and resource bounds (inclusive ranges are documented in README.md).
VOICE_MAX_AUDIO_SECS=300
VOICE_MAX_AUDIO_BYTES=52428800
VOICE_MAX_TEXT_CHARS=10000
VOICE_MAX_TTS_AUDIO_SECS=300
VOICE_REQUEST_TIMEOUT_SECS=120
VOICE_MAX_CONCURRENT_INFERENCE=2
VOICE_RATE_LIMIT_PER_SEC=5
VOICE_CACHE_TTL_SECS=600
VOICE_CACHE_MAX_ENTRIES=5000
VOICE_FFMPEG_PATH=ffmpeg
ORT_NUM_THREADS=4

# Optional verified first-run model installation. Keep disabled for mt-admin,
# which installs models explicitly before activation.
VOICE_AUTO_DOWNLOAD=false
VOICE_MODEL_MANIFEST=/models/model-manifest.json

# Logging filter used by tracing-subscriber.
RUST_LOG=lunarwing_voice_sidecar=info
