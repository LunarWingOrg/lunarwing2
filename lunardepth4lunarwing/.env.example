# Required tenant-scoped daemon-to-bridge credential. Use a random secret, never an example value.
AGENT_AUTH_TOKEN=

# Required explicit TensorMoon-compatible route; no TensorZero/worker inheritance occurs.
LUNARDEPTH_BASE_URL=https://tensormoon.example.com/openai/v1
LUNARDEPTH_MODEL=tensormoon::function_name::lunarwing

# Per-tenant, independently revocable inference credential. It is task-visible, including to the model.
LUNARDEPTH_API_KEY=

# Permit cleartext HTTP beyond loopback only after a separate private-network review.
LUNARDEPTH_ALLOW_INSECURE_HTTP=false

# Opt in only for a deliberately unauthenticated gateway. Never use this to bypass normal key setup.
LUNARDEPTH_ALLOW_PLACEHOLDER_KEY=false

LUNARWING_WORKER_ID=lunardepth
WORKSPACE_ROOT=/workspace
WS_PORT=9090
HEALTH_PORT=8443
# EXTRA_ENV_FILE=.env.secrets
