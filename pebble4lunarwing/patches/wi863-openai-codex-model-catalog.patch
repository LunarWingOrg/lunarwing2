+    /// The Codex backend serves its own catalog at `/models`, not the
+    /// OpenAI-compatible `/v1/models` the other services use. Its payload is
+    /// keyed `models` (not `data`), uses `slug` for the id, and carries the
+    /// per-model context window plus picker visibility. The backend also gates
+    /// the response on `client_version`, so the caller's version must be sent.
+    async fn fetch_openai_codex_models(&self) -> Result<ModelsResponse, ApiError> {
+        let response = self
+            .send_get_request("/models", &[("client_version", env!("CARGO_PKG_VERSION"))])
+            .await?;
+        let catalog = response
+            .json::<OpenAiCodexModelsResponse>()
+            .await
+            .map_err(ApiError::from)?;
+        Ok(catalog.into_models_response())
+    }
