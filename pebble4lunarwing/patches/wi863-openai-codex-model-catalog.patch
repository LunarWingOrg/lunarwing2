+/// Keep the live Codex catalog authoritative while still offering the models
+/// this build already knows about. The backend gates its `/models` response on
+/// the caller's `client_version`, so a Pebble release older than a given
+/// model's advertised minimum would otherwise silently drop every newer model.
+fn merge_codex_catalog(mut live: Vec<CatalogModel>) -> Vec<CatalogModel> {
+    let known = openai_codex_models();
+    for fallback in known {
+        if !live
+            .iter()
+            .any(|model| model.info.id == fallback.info.id)
+        {
+            live.push(fallback);
+        }
+    }
+    live
+}
