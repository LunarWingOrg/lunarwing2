# --- Pebble Worker Configuration ---

# Path to the pebble binary (inside the container, or on the host for native mode)
PEBBLE_BIN=pebble

# Model to use for pebble tasks
PEBBLE_MODEL=openai/gpt-5.2

# Permission mode for pebble (danger-full-access for unattended worker mode)
PEBBLE_PERMISSION_MODE=danger-full-access

# --- WebSocket Bridge ---

# Bearer token for agent authentication (empty = no auth, dev mode)
AGENT_AUTH_TOKEN=

# WebSocket listen host and port
WS_BIND_HOST=0.0.0.0
WS_PORT=9090
WS_PATH=/ws/agent

# Health endpoint port
HEALTH_PORT=8443

# Worker identity
LUNARWING_WORKER_ID=worker-pebble-01

# Default working directory for tasks
WORKSPACE_ROOT=/workspace

# --- WI#324 tool proxy ---

# Directory the per-task tool-proxy unix sockets live in (kept short: unix
# socket paths cap at ~108 bytes)
# LUNARWING_TOOL_PROXY_DIR=/tmp/lunarwing-tool-proxy

# Timeout for one proxied tool call in milliseconds (default 300000,
# clamped to 1000..900000)
# LUNARWING_TOOL_PROXY_TIMEOUT_MS=300000

# Pebble config home carrying the baked mcpServers.lunarwing registration
# (set by the image; the bridge passes it through to each pebble task)
# PEBBLE_CONFIG_HOME=/etc/lunarwing/pebble

# --- Pebble API Keys (passed through to pebble process) ---

# API key for the model provider
# NANOGPT_API_KEY=
# OPENAI_API_KEY=
