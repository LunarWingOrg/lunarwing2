# ──────────────────────────────────────────────────────────────────────────────
# LunarWing OpenCode Worker — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values.

# ── LLM / TensorZero ──────────────────────────────────────────────────────────
TENSORZERO_API_KEY=dummy

# OpenAI-compatible key (fallback, if your provider requires one)
# OPENAI_API_KEY=

# Per-tenant LLM overrides (set by lunarwing-mt-admin.sh in lunarwing.env).
# When either is set, entrypoint.sh materializes an overridden
# .opencode/opencode.json instead of using the image default.
# WI#330: the image default is a placeholder (set-opencode-base-url.invalid)
# that the entrypoint refuses to run; mt-admin renders OPENCODE_BASE_URL for
# every tenant (default: the tenant's own LLM endpoint). The URL must be
# reachable from inside the container (no host loopback, no MagicDNS names).
# OPENCODE_MODEL=tensorzero::function_name::FrontierCODE
# OPENCODE_BASE_URL=http://tensorzero.example.com:3000/openai/v1/

# Retry transient provider timeouts/routing exhaustion in the same OpenCode session.
# Retries share the task's overall timeout and preserve completed workspace work.
# OPENCODE_PROVIDER_MAX_RETRIES=2
# OPENCODE_PROVIDER_RETRY_DELAY_MS=5000
# OPENCODE_PROGRESS_HEARTBEAT_MS=60000
# OPENCODE_SESSION_ABORT_TIMEOUT_MS=5000

# ── LunarWing WebSocket Authentication ────────────────────────────────────────
AGENT_AUTH_TOKEN=

# Unique identifier for this worker instance
LUNARWING_WORKER_ID=worker-opencode-01

# ── WebSocket Server ──────────────────────────────────────────────────────────
WS_ROLE=server
WS_BIND_HOST=0.0.0.0
WS_PORT=9090
WS_PATH=/ws/agent

# Client mode: hub URL to connect to (only used when WS_ROLE=client)
# WS_URL=ws://agent-hub:9000/opencode

RECONNECT_MS=3000

# ── OpenCode Internal Server ──────────────────────────────────────────────────
OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOST=127.0.0.1
# OPENCODE_BIN=/usr/local/bin/opencode

# Basic auth for opencode serve (optional)
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode

# ── Health Check ──────────────────────────────────────────────────────────────
HEALTH_PORT=8443

# ── Container / Filesystem ────────────────────────────────────────────────────
HOST_GID=1000
FILE_UMASK=0002
WORKSPACE_ROOT=/workspace

# ── Git / GitHub Credentials ──────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GH_TOKEN=
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# ── SSH / Git Credential Mounts ──────────────────────────────────────────────
# SSH_DIR=~/.ssh
# GITCONFIG_FILE=~/.gitconfig

# ── Custom Secrets ────────────────────────────────────────────────────────────
# EXTRA_ENV_FILE=.env.secrets

# ── Config Override ───────────────────────────────────────────────────────────
# OPENCODE_CONFIG_FILE=./config/opencode.json

# ── Optional Paseo MCP Integration ────────────────────────────────────────────
# When both are set, a paseo MCP entry is injected into the opencode config.
# PASEO_URL=http://127.0.0.1:6767
# PASEO_TOKEN=your-paseo-token

# ── Optional LunarWing Study Notes MCP ────────────────────────────────────────
# mt-admin mounts code read-only and sets these container paths automatically.
# LW2STUDYMCP_HOME=/opt/lw2studymcp
# LW2STUDYMCP_STATE_HOME=/var/lib/lw2studymcp
