{
  "$schema": "https://opencode.ai/config.json",
  "model": "tensorzero/tensorzero::function_name::FrontierCODE",
  "plugin": [
    "opencode-mem",
    "opencode-caveman",
    "opencode-agent-skills",
    "envsitter-guard",
    "opentmux"
  ],
  "provider": {
    "tensorzero": {
      "name": "TensorZero",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:TENSORZERO_API_KEY}",
        "baseURL": "http://192.168.1.157:3000/openai/v1/"
      },
      "models": {
        "tensorzero::function_name::FrontierCODE": {
          "name": "tensorzero::function_name::FrontierCODE",
	  "tool_call": true,
	  "limit": {
		  "context": 859000,
		  "output": 131072
	  }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
