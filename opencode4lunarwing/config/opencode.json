{
  "$schema": "https://opencode.ai/config.json",
  "model": "tensorzero/tensorzero::function_name::lunarwing",
  "share": "disabled",
  "plugin": [
    "opencode-mem",
    "opencode-caveman",
    "opencode-agent-skills",
    "envsitter-guard",
    "opentmux"
  ],
  "provider": {
    "tensorzero": {
      "name": "TensorZero",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "unneeded",
        "baseURL": "http://set-opencode-base-url.invalid/openai/v1/"
      },
      "models": {
        "tensorzero::function_name::lunarwing": {
          "name": "tensorzero::function_name::lunarwing",
	  "tool_call": true,
	  "limit": {
		  "context": 959000,
		  "output": 131072
	  }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
