# ──────────────────────────────────────────────────────────────────────────────
# LunarWing Kimi Code Worker — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values.

# ── Kimi Code CLI ────────────────────────────────────────────────────────────
# The worker runs `kimi -p <prompt> --output-format stream-json` internally.
# Install/upgrade the CLI by rebuilding the image with a different
# KIMI_CODE_VERSION build arg (default 2.1.1).

# Per-tenant LLM overrides (set by lunarwing-mt-admin.sh in lunarwing.env).
# When any is set, entrypoint.sh materializes an overridden
# .kimi-code/config.toml instead of using the image default.
# The baked default provider is the TensorMoon gateway (OpenAI-compatible)
# reached over the NetBird overlay with the FrontierCODEK function.
# KIMI_MODEL is the model id sent to the API (e.g. another TensorMoon function);
# when it matches an alias in config.toml it selects that alias instead.
# KIMI_MODEL=tensormoon::function_name::FrontierCODEK
# KIMI_BASE_URL=http://cotterhomelab3.netbird.selfhosted:3000/openai/v1

# API key written to config.toml. Falls back to TENSORMOON_API_KEY when unset
# (TENSORZERO_API_KEY, the pre-fork name, is still honoured after that).
# KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TENSORMOON_API_KEY=

# Progress heartbeat interval (ms); 0 disables.
# KIMI_PROGRESS_HEARTBEAT_MS=120000

# Grace period (ms) before SIGKILL after SIGTERM on cancel/timeout.
# KIMI_KILL_GRACE_MS=7000

# Silence watchdog (ms, WI#263): if the kimi CLI emits no stream output for
# this long the task is treated as wedged (observed at final report
# composition), killed, and resolved as timed_out with whatever partial
# output was streamed. 0 disables. Default 900000 (15 minutes).
# KIMI_SILENCE_TIMEOUT_MS=900000

# ── LunarWing WebSocket Authentication ────────────────────────────────────────
# Required in server mode, including loopback binds.
AGENT_AUTH_TOKEN=

# Unique identifier for this worker instance
LUNARWING_WORKER_ID=worker-kimi-01

# ── WebSocket Server ──────────────────────────────────────────────────────────
WS_ROLE=server
WS_BIND_HOST=0.0.0.0
WS_PORT=9090
WS_PATH=/ws/agent
# KIMI_MAX_CONCURRENT_TASKS=8
# KIMI_MAX_TIMEOUT_MS=14400000
# KIMI_MAX_TASK_ID_BYTES=256

# Client mode: hub URL to connect to (only used when WS_ROLE=client)
# WS_URL=ws://agent-hub:9000/kimi

RECONNECT_MS=3000
PING_INTERVAL_MS=20000

# ── Health Check ──────────────────────────────────────────────────────────────
HEALTH_PORT=8443

# ── Container / Filesystem ────────────────────────────────────────────────────
HOST_GID=1000
FILE_UMASK=0002
WORKSPACE_ROOT=/workspace
KIMI_CODE_HOME=/home/kimi/.kimi-code

# ── Git / GitHub Credentials ──────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GH_TOKEN=
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# ── SSH / Git Credential Mounts ──────────────────────────────────────────────
# SSH_DIR=~/.ssh
# GITCONFIG_FILE=~/.gitconfig

# ── Custom Secrets ────────────────────────────────────────────────────────────
# EXTRA_ENV_FILE=.env.secrets
