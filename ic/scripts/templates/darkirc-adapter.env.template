# Per-tenant darkirc adapter environment
# Auto-generated by lunarwing-mt-admin — do not edit manually.
# Placeholders substituted at generation time:
#   __DARKIRC_IRC_PORT__   — tenant's darkirc IRC port
#   __DARKIRC_ADAPTER_PORT__ — tenant's darkirc adapter port
#   __ADAPTER_SECRET__     — adapter authentication secret (32-char token)
#   __TENANT_NAME__        — tenant OS username

DARKIRC_HOST=127.0.0.1
DARKIRC_PORT=__DARKIRC_IRC_PORT__
DARKIRC_NICK=__TENANT_NAME__-bridge
DARKIRC_USER=__TENANT_NAME__
DARKIRC_REALNAME="LunarWing DarkIRC Bridge (__TENANT_NAME__)"
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=__DARKIRC_ADAPTER_PORT__
ADAPTER_SECRET=__ADAPTER_SECRET__
ADAPTER_LOG_LEVEL=INFO

# ── Outbound delivery tuning (defaults shown; uncomment to override) ──
# Minimum seconds between PRIVMSG sends. DarkFi meters the network and drops
# messages sent faster than this; lower it only if your darkirc deployment
# demonstrably tolerates a faster rate.
#DARKIRC_PRIVMSG_INTERVAL=7.0
# Max UTF-8 bytes per IRC message chunk. 400 is conservative under the
# 512-byte IRC frame; can be raised toward ~450 if your deployment relays
# larger frames reliably (the adapter still clamps per-target frame size).
#DARKIRC_MAX_MESSAGE_BYTES=400
# Max chunks the paced outbox holds before /send returns 429.
#ADAPTER_MAX_OUTBOX=400
# Persist queued chunks across adapter restarts (path to a JSON journal).
# Recommended for production tenants so a restart doesn't drop a backlog.
#ADAPTER_OUTBOX_JOURNAL=/var/lib/lunarwing/__TENANT_NAME__/darkirc-outbox.json
