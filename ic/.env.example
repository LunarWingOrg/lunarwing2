# Database Configuration
DATABASE_URL=postgres://localhost/lunarwing
DATABASE_POOL_SIZE=10

# LLM Provider
# LLM_BACKEND=openai_compatible
# Possible values: ollama, openai_compatible
# LLM_REQUEST_TIMEOUT_SECS=120  # Increase for local LLMs (Ollama, vLLM, LM Studio)

# Local LLM Providers (Ollama, LM Studio, vLLM, LiteLLM)

# === Ollama ===
# OLLAMA_MODEL=llama3.2
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434   # default

# === OpenAI-compatible (LM Studio, vLLM, Anything-LLM) ===
# LLM_MODEL=llama-3.2-3b-instruct-q4_K_M
# LLM_BACKEND=openai_compatible
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=sk-...                        # optional for local servers
# Custom HTTP headers for OpenAI-compatible providers
# Format: comma-separated key:value pairs
# LLM_EXTRA_HEADERS=HTTP-Referer:https://git.lunarwing.org/lunarwing/lunarwing2,X-Title:lunarwing

# For full provider setup guide see docs/LLM_PROVIDERS.md

# Channel Configuration
# CLI is always enabled

# HTTP Webhook Server (optional)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_WEBHOOK_SECRET=your-webhook-secret
# Webhook authentication uses HMAC-SHA256 signature verification.
# Callers must send an X-Hub-Signature-256 header with format: sha256=<hex_digest>
# where the digest is HMAC-SHA256(HTTP_WEBHOOK_SECRET, raw_request_body) in lowercase hex.
#
# Example (bash):
#   BODY='{"content":"hello"}'
#   SIG=$(echo -n "$BODY" | openssl dgst -sha256 -hmac "$HTTP_WEBHOOK_SECRET" | cut -d' ' -f2)
#   curl -X POST http://localhost:8080/webhook \
#     -H "Content-Type: application/json" \
#     -H "X-Hub-Signature-256: sha256=$SIG" \
#     -d "$BODY"
#
# DEPRECATED: Passing "secret" in the JSON body still works but will be removed in a future release.

# Managed Tunnel (optional)
# NetBird peer enrollment and daemon lifecycle remain operator-managed.
# See ../docs/guides/NETBIRD_TUNNEL.md for self-hosted Reverse Proxy setup.
# Legacy managed provider migration: ../docs/guides/TUNNEL_PROVIDER_MIGRATION.md
# TUNNEL_PROVIDER=netbird
# TUNNEL_NETBIRD_NAME_PREFIX=lunarwing
# TUNNEL_NETBIRD_CUSTOM_DOMAIN=lunarwing.example.com  # optional; recommended for stable callbacks

# Signal Channel (optional, requires signal-cli daemon --http)
# SIGNAL_HTTP_URL=http://127.0.0.1:8080
# SIGNAL_ACCOUNT=+1234567890
# SIGNAL_ALLOW_FROM=+1234567890,uuid:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # comma-separated, * for all, empty = deny/require pairing
# SIGNAL_ALLOW_FROM_GROUPS=                        # comma-separated group IDs, * for all, empty = deny all groups
# SIGNAL_DM_POLICY=pairing                         # open | allowlist | pairing
# SIGNAL_GROUP_POLICY=allowlist                    # allowlist | open | disabled
# SIGNAL_GROUP_ALLOW_FROM=                         # comma-separated, empty = inherit from ALLOW_FROM
# SIGNAL_IGNORE_ATTACHMENTS=false
# SIGNAL_IGNORE_STORIES=true

# Agent Settings
AGENT_NAME=ruffles
AGENT_MAX_PARALLEL_JOBS=15
AGENT_JOB_TIMEOUT_SECS=5555
AGENT_STUCK_THRESHOLD_SECS=555
# Maximum tokens per job (0 = unlimited, also settable via settings.json agent.max_tokens_per_job)
# AGENT_MAX_TOKENS_PER_JOB=0
# Enable planning phase before tool execution (default: true)
AGENT_USE_PLANNING=false

# Shared LunarWing Study Notes MCP (optional; read-only by default)
# Absolute path to a canonical https://git.lunarwing.org/cmc/lw2studymcp checkout.
# Startup creates or refreshes an owner-scoped `study_notes` stdio MCP configuration.
# LW2STUDYMCP_HOME=/srv/lunarwing/lw2studymcp
# Writes require separate mutable state; code and skill remain read-only.
# This enables core-agent write tools only; OpenCode workers remain read-only.
# LW2STUDYMCP_STATE_HOME=/srv/lunarwing/study-notes-state
# LW2STUDYMCP_ALLOW_WRITE=0

# Self-repair settings
SELF_REPAIR_CHECK_INTERVAL_SECS=120
SELF_REPAIR_MAX_ATTEMPTS=5

# Reflex compiler (optional; disabled by default)
# REFLEX_COMPILER_ENABLED=false
# Semantic matching can call a remote embedding provider before the normal LLM path,
# so it requires a separate explicit opt-in even when the compiler is enabled.
# REFLEX_SEMANTIC_ENABLED=false
# REFLEX_FUZZY_THRESHOLD=0.85
# REFLEX_SEMANTIC_THRESHOLD=0.75

# Heartbeat settings (proactive periodic execution)
# When enabled, reads HEARTBEAT.md checklist and reports findings
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_SECS=1800
HEARTBEAT_NOTIFY_CHANNEL=cli
HEARTBEAT_NOTIFY_USER=default

# Memory hygiene settings (automatic cleanup of stale workspace documents)
# Runs on each heartbeat tick; identity files (IDENTITY.md, SOUL.md) are never deleted
# MEMORY_HYGIENE_ENABLED=true
# MEMORY_HYGIENE_DAILY_RETENTION_DAYS=30         # delete daily/ docs older than this many days
# MEMORY_HYGIENE_CONVERSATION_RETENTION_DAYS=7   # delete conversations/ docs older than this many days
# MEMORY_HYGIENE_CADENCE_HOURS=12                # minimum hours between cleanup passes

# Study-notes knowledge sweep (marks aging study notes stale in the background)
# Runs on each heartbeat tick next to memory hygiene; notes are workspace
# documents under study-notes/ with provenance 'study-note' (native knowledge_* tools)
# KNOWLEDGE_SWEEP_ENABLED=true                   # master switch for the sweep
# KNOWLEDGE_STALE_AFTER_DAYS=30                  # notes studied/updated older than this become stale
# KNOWLEDGE_SWEEP_CADENCE_HOURS=24               # minimum hours between sweeps
# KNOWLEDGE_SWEEP_INCLUDE_SHARED=true            # also sweep the shared herd scope

# Cross-tenant knowledge sharing over configured coordination rooms.
# Requires actionable COORD_ENABLED/COORD_AGENT_ID/COORD_CHANNELS settings and
# a database-backed workspace. Every watching daemon stores valid one-line
# `KNOW: <topic-slug> | <finding>` claims in its own shared scope as
# needs-verification; wire notes never overwrite native agent versions. Only
# sender IDs listed in COORD_KNOWLEDGE_PUBLISHERS are ingested.
# COORD_KNOWLEDGE_SHARE=false                     # opt in to KNOW: ingestion
# COORD_KNOWLEDGE_PUBLISH=false                   # opt in to KNOW: emission; enable only
#                                                 # when every room daemon accepts the tag
# COORD_KNOWLEDGE_PUBLISHERS=agent-a@conf.example/res,agent-b
# COORD_KNOWLEDGE_MAX_PER_HOUR=30                 # per sender; valid range 1..=1000
# COORD_KNOWLEDGE_MIN_CHARS=12                    # finding characters; valid range 1..=420

# Docker Sandbox
# SANDBOX_ENABLED=true
# SANDBOX_POLICY=readonly                # readonly, workspace_write, or full_access
# SANDBOX_ALLOW_FULL_ACCESS=false        # REQUIRED second opt-in for full_access policy.
#                                        # FullAccess bypasses Docker entirely and runs
#                                        # commands directly on the host. Without this
#                                        # set to "true", full_access is downgraded to
#                                        # workspace_write.
# SANDBOX_IMAGE=lunarwing-worker:latest
# SANDBOX_TIMEOUT_SECS=120
# SANDBOX_MEMORY_LIMIT_MB=2048

# Safety settings
SAFETY_MAX_OUTPUT_LENGTH=100000
SAFETY_INJECTION_CHECK_ENABLED=false

# Restart Feature (Docker containers only)
# Set LUNARWING_IN_DOCKER=true in the container entrypoint to enable the restart feature.
# Legacy aliases using IRONCLAW_* are still accepted.
# Without this, the restart tool and /restart command will be disabled.
# LUNARWING_IN_DOCKER=false
# LUNARWING_RESTART_DELAY=5          # default wait before exit (seconds, range: 1-30)
# LUNARWING_MAX_FAILURES=10          # max consecutive failures before container exits

# Logging
RUST_LOG=lunarwing=debug,tower_http=debug
