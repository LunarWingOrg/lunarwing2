[package]
name = "rxml_proc"
version = "0.12.1"
authors = ["Jonas Schäfer <jonas@zombofant.net>"]
license = "MIT"
edition = "2021"
description = "Macros to, at compile time, validate strings against the CData, Name and NCName productions from the XML 1.0 grammar."
repository = "https://codeberg.org/jssfr/rxml"
keywords = ["xml"]
categories = ["parsing"]
readme = true

[dependencies]
syn = { version = "^2" }
rxml_validation = { version = "^0.11.0", default-features = false }
quote = { version = "^1" }

[lib]
proc-macro = true

